{
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "workspaceId": {
      "type": "string",
      "minLength": 1
    },
    "projectId": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "todo",
        "in_progress",
        "blocked",
        "done",
        "cancelled"
      ]
    },
    "priority": {
      "type": "string",
      "enum": [
        "p0",
        "p1",
        "p2",
        "p3"
      ]
    },
    "dueDate": {
      "type": "string",
      "format": "date-time"
    },
    "provenanceOrigin": {
      "type": "string",
      "enum": [
        "human",
        "meeting_close",
        "ingestion",
        "gbrain_proposal",
        "parity_remediation",
        "project_capture",
        "project_sync",
        "copilot_propose"
      ]
    }
  },
  "required": [
    "id",
    "workspaceId",
    "title",
    "status",
    "provenanceOrigin"
  ],
  "additionalProperties": false,
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "sow:task"
}
